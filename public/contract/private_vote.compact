pragma language_version 0.23;

import CompactStandardLibrary;

// A single contract stores many independent proposals. Proposal ids are
// caller-supplied 32-byte domain identifiers; every per-proposal value is
// keyed by that id.
export ledger proposalTitleHashes: Map<Bytes<32>, Bytes<32>>;
export ledger proposalStatus: Map<Bytes<32>, Uint<8>>;
export ledger proposalAdminCommitments: Map<Bytes<32>, Bytes<32>>;
export ledger proposalEligibilityRoots: Map<Bytes<32>, MerkleTreeDigest>;
export ledger proposalBallotCounts: Map<Bytes<32>, Uint<32>>;

// Nullifiers bind to both voter secret and proposal id, preventing replay
// within a proposal while allowing the same voter to vote in another one.
export ledger nullifiers: Map<Bytes<32>, Boolean>;
export ledger voteCommitments: Map<Bytes<32>, Bytes<32>>;

witness localVoterSecret(): Bytes<32>;
witness localVoteChoice(): Uint<8>;
witness localBlindingFactor(): Bytes<32>;
witness localEligibilityProof(): MerkleTreePath<8, Bytes<32>>;
witness localProposalAdminSecret(proposalId: Bytes<32>): Bytes<32>;

circuit deriveNullifier(voterSecret: Bytes<32>, targetProposal: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([voterSecret, targetProposal]);
}

circuit deriveVoteCommitment(choice: Uint<8>, blinding: Bytes<32>): Bytes<32> {
  const choiceBytes = choice as Field as Bytes<32>;
  return persistentHash<Vector<2, Bytes<32>>>([choiceBytes, blinding]);
}

export circuit initializeProposal(
  proposalId: Bytes<32>,
  titleHash: Bytes<32>,
  adminCommitment: Bytes<32>,
  eligibilityRoot: MerkleTreeDigest
): [] {
  const id = disclose(proposalId);
  assert(!proposalStatus.member(id), "Proposal already exists");
  proposalTitleHashes.insert(id, disclose(titleHash));
  proposalStatus.insert(id, 1);
  proposalAdminCommitments.insert(id, disclose(adminCommitment));
  proposalEligibilityRoots.insert(id, disclose(eligibilityRoot));
  proposalBallotCounts.insert(id, 0);
}

export circuit castPrivateVote(proposalId: Bytes<32>): [] {
  const id = disclose(proposalId);
  assert(proposalStatus.member(id), "Proposal not found");
  assert(proposalStatus.lookup(id) == 1, "Voting is closed");

  const voterSecret = localVoterSecret();
  const voteChoice = localVoteChoice();
  const blindingFactor = localBlindingFactor();
  const merkleProof = localEligibilityProof();
  assert(voteChoice <= 2, "Invalid vote choice");

  const identityCommitment = persistentHash<Vector<1, Bytes<32>>>([voterSecret]);
  const eligibilityRoot = proposalEligibilityRoots.lookup(id);
  assert(merkleProof.leaf == identityCommitment, "Eligibility proof leaf mismatch");
  assert(
    merkleTreePathRoot<8, Bytes<32>>(merkleProof) == eligibilityRoot,
    "Voter is not eligible"
  );

  const nullifier = disclose(deriveNullifier(voterSecret, id));
  assert(!nullifiers.member(nullifier), "Voter has already voted on this proposal");
  const commitment = deriveVoteCommitment(voteChoice, blindingFactor);
  const ballotCount = proposalBallotCounts.lookup(id);
  assert(ballotCount < 4294967295, "Proposal has reached the ballot limit");

  nullifiers.insert(nullifier, true);
  voteCommitments.insert(nullifier, disclose(commitment));
  proposalBallotCounts.insert(id, (ballotCount + 1) as Uint<32>);
}

export circuit closeProposal(proposalId: Bytes<32>): [] {
  const id = disclose(proposalId);
  assert(proposalStatus.member(id), "Proposal not found");
  assert(proposalStatus.lookup(id) == 1, "Proposal is not open");
  const adminSecret = localProposalAdminSecret(id);
  const suppliedCommitment = persistentHash<Vector<1, Bytes<32>>>([adminSecret]);
  assert(
    suppliedCommitment == proposalAdminCommitments.lookup(id),
    "Invalid proposal administrator secret"
  );
  proposalStatus.insert(id, 2);
}
