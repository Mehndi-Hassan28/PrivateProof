zkir_version: "2.1.0"
program: "PrivateVote"
circuits:
  - name: "initializeProposal"
    num_public_inputs: 5
    num_private_inputs: 0
    gates_count: 142
  - name: "castPrivateVote"
    num_public_inputs: 2
    num_private_inputs: 11
